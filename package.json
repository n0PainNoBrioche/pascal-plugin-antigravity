{
  "name": "@pascal-plugin/antigravity",
  "version": "0.1.0",
  "description": "Antigravity AI chat sidebar plugin for Pascal Editor with live Pascal MCP integration (Next.js host adapter + standalone local bridge).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "antigravity-pascal-bridge": "./src/bridge/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./bridge": {
      "types": "./src/bridge/cli.ts",
      "default": "./src/bridge/cli.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "HOST_INTEGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "bridge": "node --experimental-strip-types src/bridge/cli.ts"
  },
  "peerDependencies": {
    "@pascal-app/core": ">=0.9.2 <2.0.0",
    "@pascal-app/editor": ">=0.9.2 <2.0.0",
    "@pascal-app/viewer": ">=0.9.2 <2.0.0",
    "react": "^18 || ^19",
    "three": ">=0.184.0"
  },
  "devDependencies": {
    "@pascal-app/core": "^1.1.6",
    "@pascal-app/editor": "^1.1.6",
    "@pascal-app/viewer": "^1.1.6",
    "@types/node": "^22.19.12",
    "@types/react": "^19.2.2",
    "@types/three": "^0.187.0",
    "react": "^19.0.0",
    "three": "^0.187.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "pascal",
    "antigravity",
    "mcp",
    "3d",
    "architecture",
    "ai",
    "chat",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n0PainNoBrioche/pascal-plugin-antigravity.git"
  },
  "homepage": "https://github.com/n0PainNoBrioche/pascal-plugin-antigravity#readme",
  "bugs": {
    "url": "https://github.com/n0PainNoBrioche/pascal-plugin-antigravity/issues"
  },
  "license": "MIT"
}
